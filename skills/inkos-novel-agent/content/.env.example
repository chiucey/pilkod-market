# InkOS Configuration Template
# Copy this file to .env and fill in your values

# Required: LLM Provider
# Options: openai | anthropic | custom
INKOS_LLM_PROVIDER=openai

# Required: API Configuration
INKOS_LLM_BASE_URL=https://api.openai.com/v1
INKOS_LLM_API_KEY=your-api-key-here
INKOS_LLM_MODEL=gpt-4o

# Optional: Model Parameters
# INKOS_LLM_TEMPERATURE=0.7
# INKOS_LLM_MAX_TOKENS=8192
# INKOS_LLM_THINKING_BUDGET=0

# Optional: Multi-Model Routing
# INKOS_WRITER_MODEL=gpt-4o
# INKOS_WRITER_PROVIDER=openai
# INKOS_AUDITOR_MODEL=gpt-4o-mini
# INKOS_AUDITOR_PROVIDER=openai
# INKOS_RADAR_MODEL=claude-sonnet
# INKOS_RADAR_PROVIDER=anthropic

# Optional: Notification Settings
# INKOS_NOTIFY_WEBHOOK_URL=https://your-webhook.com/notify
# INKOS_NOTIFY_TELEGRAM_BOT_TOKEN=
# INKOS_NOTIFY_TELEGRAM_CHAT_ID=
