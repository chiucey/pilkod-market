# Stock Scout A股版 - 配置文件
# 所有敏感信息在此管理，代码不直接引用

# ============ Tushare API ============
TUSHARE_TOKEN = "your_tushare_token"

# ============ Feishu (飞书) ============
FEISHU_APP_TOKEN = ""   # TODO: 填入飞书应用App Token
FEISHU_TABLE_ID = ""    # TODO: 填入飞书Bitable Table ID

# ============ MiniMax LLM ============
MINIMAX_API_KEY = ""    # TODO: 填入MiniMax API Key
MINIMAX_BASE_URL = "https://api.minimax.chat/v1"

# ============ 选股参数 (Tab7) ============
MIN_INSTITUTIONAL_PCT = 50       # 最低机构持仓% (注：A股无13F，用北向持仓代替)
MIN_SCORE = 65                   # 综合评分阈值，高于此分进入Scout结果
SECTOR = "科技"                  # 申万一级行业筛选
MAX_FLOAT_MILLION = 500         # 最大流通盘（万股）
PHASE_INCLUDE = ["启动期", "上升期", "资金流入"]  # 纳入的信号类型
PHASE_EXCLUDE = ["派发期", "下降期", "资金流出"] # 排除的信号类型
MIN_MARGIN_RATIO = 0            # 最低融资余额变动%（可填负数）
MIN_HK_HOLD_PCT = 1             # 最低北向持股%

# ============ 评分权重 (可调) ============
WEIGHT_NORTHBOUND = 0.25        # 北向资金权重
WEIGHT_MONEYFLOW = 0.25         # 主力资金流权重
WEIGHT_MARGIN = 0.15            # 融资余额权重
WEIGHT_TECHNICAL = 0.20         # 技术动能权重
WEIGHT_BROKER = 0.10            # 券商研报权重
WEIGHT_LIMITUP = 0.05          # 涨停/炸板信号权重

# ============ 系统参数 ============
DB_PATH = "data/scout.db"       # SQLite数据库路径
LOG_LEVEL = "INFO"              # 日志级别
