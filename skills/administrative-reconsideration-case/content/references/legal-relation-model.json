{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "行政复议案件法律关系数字模型",
  "version": "1.0",
  "description": "用于行政复议案件申请材料的法律关系梳理",

  "案件基础信息": {
    "案件编号": {"type": "string", "description": "行政复议案件唯一标识"},
    "案件来源": {
      "type": "string",
      "enum": ["首次申请", "补充申请", "重新申请"]
    },
    "案件分类": {
      "大类": {
        "type": "string",
        "enum": [
          "行政处罚类", "行政强制类", "行政许可类", "自然资源确权类",
          "征收补偿类", "工伤认定类", "赔偿决定类", "经营自主权类",
          "公平竞争类", "违法设定义务类", "不作为类", "社会保障类",
          "行政协议类", "政府信息公开类"
        ]
      },
      "小类": {"type": "string", "description": "具体行政行为类型"}
    },
    "申请日期": {"type": "string", "format": "date"},
    "受理日期": {"type": "string", "format": "date"},
    "审理期限": {
      "type": "string",
      "enum": ["30日(简易)", "60日", "90日(延长)"]
    },
    "审理程序": {
      "type": "string",
      "enum": ["普通程序", "简易程序"]
    }
  },

  "当事人信息": {
    "申请人": {
      "类型": {
        "type": "string",
        "enum": ["公民", "法人", "其他组织"]
      },
      "基本信息": {
        "姓名名称": {"type": "string"},
        "证件类型": {"type": "string"},
        "证件号码": {"type": "string"},
        "住所地": {"type": "string"},
        "联系方式": {"type": "string"}
      },
      "申请资格依据": {
        "type": "string",
        "enum": ["自身权益受损", "近亲属继承", "权利承受人", "法定代理人"]
      },
      "资格继承信息": {
        "公民死亡": {"type": "object", "properties": {"近亲属": {"type": "string"}}},
        "法人终止": {"type": "object", "properties": {"权利承受人": {"type": "string"}}}
      }
    },
    "被申请人": {
      "名称": {"type": "string"},
      "统一社会信用代码": {"type": "string"},
      "住所地": {"type": "string"},
      "法定代表人": {"type": "string"},
      "作出行为部门": {"type": "string"},
      "管辖关系": {
        "type": "string",
        "enum": ["本级政府工作部门", "下一级政府", "派出机关", "授权组织", "垂直领导机关"]
      }
    },
    "第三人": {
      "是否涉及": {"type": "boolean"},
      "基本信息": {"type": "object"},
      "第三人类型": {"type": "string"}
    }
  },

  "行政行为信息": {
    "行为类型": {"type": "string"},
    "行为名称": {"type": "string"},
    "作出日期": {"type": "string", "format": "date"},
    "文书编号": {"type": "string"},
    "行为内容摘要": {"type": "string"},
    "法律依据": {
      "法律": {"type": "string"},
      "行政法规": {"type": "string"},
      "地方性法规": {"type": "string"},
      "规章": {"type": "string"}
    },
    "行为载体": {
      "类型": {"type": "string"},
      "名称": {"type": "string"}
    }
  },

  "法律关系要素": {
    "主体要素": {
      "行政管理方": {"type": "string", "description": "作出行政行为的行政机关"},
      "管理相对方": {"type": "string", "description": "行政行为直接作用的对象"},
      "利害关系方": {"type": "string", "description": "与行政行为有利害关系的第三方"}
    },
    "权利义务要素": {
      "申请人权利": {
        "type": "array",
        "items": {"type": "string"},
        "examples": ["陈述权", "申辩权", "听证权", "知情权", "赔偿权", "诉讼权"]
      },
      "申请人义务": {
        "type": "array",
        "items": {"type": "string"},
        "examples": ["遵守程序义务", "举证义务", "履行义务"]
      },
      "被申请人职权": {
        "type": "array",
        "items": {"type": "string"},
        "examples": ["调查权", "决定权", "执行权"]
      },
      "被申请人职责": {
        "type": "array",
        "items": {"type": "string"},
        "examples": ["法定职责", "程序义务", "说明理由义务", "举证责任"]
      }
    },
    "争议焦点": {
      "事实争议": {"type": "string"},
      "法律争议": {"type": "string"},
      "程序争议": {"type": "string"}
    }
  },

  "申请材料清单": {
    "必要材料": {
      "行政复议申请书": {
        "数量": "2份",
        "内容要求": "申请人/被申请人信息、复议请求、事实与理由",
        "签名": "申请人签名或盖章"
      },
      "身份证明": {
        "公民": "身份证复印件",
        "法人": "营业执照复印件+法定代表人身份证明",
        "其他组织": "主体资格证明"
      },
      "证据材料": {
        "证明行政行为存在": "处罚决定书、强制措施决定书等",
        "证明合法权益受损": "财产损失证明、人身损害证明",
        "证明因果关系": "相关证据材料"
      },
      "授权委托": {
        "委托原因": "string",
        "代理范围": {"type": "string", "enum": ["一般代理", "特别授权"]},
        "委托期限": "string",
        "代理人信息": "string"
      }
    },
    "分类材料": {
      "行政处罚类": {
        "处罚决定书": "原件或复印件",
        "听证材料": "听证笔录、听证报告(如有)",
        "陈述申辩材料": "书面陈述申辩意见(如有)",
        "证明违法行为证据": "现场检查笔录、照片、视频等",
        "证明情节轻重证据": "包括从轻、减轻或从重情节"
      },
      "行政强制类": {
        "强制措施决定书": "原件或复印件",
        "查封扣押清单": "财产清单",
        "强制执行决定书": "如有",
        "强制执行凭证": "执行时出具的相关凭证"
      },
      "行政许可类": {
        "许可申请材料": "申请书及附件",
        "不予许可决定书": "原件",
        "许可依据材料": "相关法律法规",
        "证明符合许可条件证据": "专业技术资质、资金证明等"
      },
      "工伤认定类": {
        "工伤认定决定书": "原件",
        "劳动关系证明": "劳动合同、工资流水等",
        "事故证明材料": "证人证言、监控录像等",
        "诊疗材料": "病历、诊断证明、医疗费票据",
        "死亡证明": "如涉及工亡"
      },
      "征收补偿类": {
        "征收决定": "复印件",
        "补偿方案": "复印件",
        "权属证明": "房产证、土地证等",
        "评估报告": "财产评估报告",
        "补偿计算依据": "补偿数额计算明细",
        "停产停业损失证明": "经营损失相关证据"
      },
      "政府信息公开类": {
        "信息公开申请": "复印件",
        "答复书": "原件",
        "申请公开的信息描述": "具体描述所需信息",
        "自身特殊需要说明": "说明申请信息与自身利益关系"
      },
      "行政协议类": {
        "行政协议": "原件或复印件",
        "协议履行证据": "履约证明、付款凭证等",
        "违约证据": "对方违约行为证明",
        "损失计算依据": "赔偿数额计算明细"
      },
      "赔偿决定类": {
        "赔偿决定书": "原件",
        "损失证明": "财产损失或人身损害证明",
        "赔偿计算依据": "赔偿数额计算明细"
      }
    }
  },

  "法律依据库": {
    "程序依据": [
      "《中华人民共和国行政复议法》(2023修订)",
      "《中华人民共和国行政复议法实施条例》"
    ],
    "实体依据": {
      "行政处罚": ["《中华人民共和国行政处罚法》"],
      "行政强制": ["《中华人民共和国行政强制法》"],
      "行政许可": ["《中华人民共和国行政许可法》"],
      "工伤认定": ["《工伤保险条例》"],
      "国家赔偿": ["《中华人民共和国国家赔偿法》"],
      "政府信息公开": ["《中华人民共和国政府信息公开条例》"],
      "征收补偿": [
        "《中华人民共和国土地管理法》",
        "《国有土地上房屋征收与补偿条例》"
      ],
      "自然资源": [
        "《中华人民共和国矿产资源法》",
        "《中华人民共和国森林法》"
      ],
      "公平竞争": [
        "《中华人民共和国反垄断法》",
        "《公平竞争审查制度实施细则》"
      ]
    }
  },

  "审查要点": {
    "受理条件审查": {
      "受案范围": "是否属于行政复议受案范围",
      "申请人资格": "申请人与行政行为是否有利害关系",
      "申请期限": "是否在法定期限内申请",
      "管辖": "是否有明确的被申请人"
    },
    "实体审查": {
      "事实审查": "行政行为认定的事实是否清楚",
      "证据审查": "证据是否确凿充分",
      "依据审查": "适用依据是否正确",
      "程序审查": "行政程序是否合法",
      "适当性审查": "行政行为内容是否适当"
    }
  },

  "决定类型映射": {
    "维持决定": {
      "条件": ["事实清楚", "证据确凿", "适用依据正确", "程序合法", "内容适当"]
    },
    "变更决定": {
      "条件": ["事实清楚，证据确凿，程序合法，但内容不适当", "事实清楚，证据确凿，程序合法，但未正确适用依据", "事实不清、证据不足，经查清事实和证据"]
    },
    "撤销或部分撤销决定": {
      "条件": ["主要事实不清、证据不足", "违反法定程序", "依据不合法", "超越职权或滥用职权"]
    },
    "确认违法决定": {
      "条件": ["撤销会给国家利益、社会公共利益造成重大损害", "程序轻微违法但对申请人权利不产生实际影响", "违法但不具有可撤销内容", "被申请人改变原违法行政行为", "被申请人不履行法定职责，责令履行没有意义"]
    },
    "确认无效决定": {
      "条件": ["行政行为有重大且明显违法情形"]
    },
    "责令履行决定": {
      "条件": ["被申请人不履行法定职责"]
    },
    "驳回申请决定": {
      "条件": ["被申请人没有相应法定职责或已履行法定职责"]
    }
  },

  "管辖规则": {
    "地方政府工作部门": "本级人民政府",
    "下一级人民政府": "本级人民政府",
    "派出机关": "设立该派出机关的人民政府",
    "授权组织": "管理该组织的政府或政府部门",
    "国务院部门": "作出该行为的国务院部门",
    "垂直领导机关": "上一级主管部门"
  }
}
