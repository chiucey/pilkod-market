#!/bin/bash
# Pre-removal script
# Executed before files are removed

set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Actions before package removal
        # Example: Stop services, save state, etc.

        # Stop service if running
        if command -v systemctl &> /dev/null; then
            systemctl stop {{PACKAGE_NAME}} 2>/dev/null || true
        fi
        ;;
    failed-upgrade)
        # Handle failed upgrade
        exit 0
        ;;
esac

exit 0
