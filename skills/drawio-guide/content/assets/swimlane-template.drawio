<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="5.0" version="21.0.0">
  <diagram name="泳道流程图模板" id="swimlane-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 泳道容器 -->
        <mxCell id="swimlane-header" value="行政流程泳道图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        
        <!-- 泳道1: 发起人 -->
        <mxCell id="swimlane-1" value="发起人" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="80" width="400" height="400" as="geometry" />
        </mxCell>
        
        <!-- 泳道1内容 -->
        <mxCell id="act-1" value="填写申请表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;fontColor=#ffffff;" vertex="1" parent="swimlane-1">
          <mxGeometry x="100" y="50" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- 泳道2: 审批人 -->
        <mxCell id="swimlane-2" value="审批人" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="400" height="400" as="geometry" />
        </mxCell>
        
        <!-- 泳道2内容 -->
        <mxCell id="dec-1" value="审批?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ED7D31;" vertex="1" parent="swimlane-2">
          <mxGeometry x="100" y="50" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- 连接线 -->
        <mxCell id="arrow-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="act-1" target="dec-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 标注 -->
        <mxCell id="label-yes" value="是" style="text;html=1;align=center;verticalAlign=middle;fontColor=#70AD47;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="40" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="label-no" value="否" style="text;html=1;align=center;verticalAlign=middle;fontColor=#C00000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="40" height="20" as="geometry" />
        </mxCell>
        
        <!-- 结果节点 -->
        <mxCell id="result-pass" value="通过" style="ellipse;whiteSpace=wrap;html=1;fillColor=#70AD47;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="100" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="result-reject" value="驳回" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C00000;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="200" y="360" width="100" height="60" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
