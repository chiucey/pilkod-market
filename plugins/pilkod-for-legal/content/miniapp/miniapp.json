{
  "schemaVersion": 1,
  "artifacts": {
    "client": ["./miniapp/client"],
    "node": ["./miniapp/node"]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": { "path": "/legal" },
  "agentAccess": ["session.run", "session.read"],
  "agentConcurrency": 16,
  "mcpEndpoints": [
    { "server": "minimax-for-legal", "path": "/mcp/minimax-for-legal" }
  ]
}
