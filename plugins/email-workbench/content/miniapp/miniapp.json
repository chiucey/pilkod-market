{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/email"
  },
  "mcpEndpoints": [
    {
      "server": "email-workbench",
      "path": "/mcp/email"
    }
  ],
  "hostConnectorAccess": {
    "providers": [
      "email_workbench_credentials"
    ]
  }
}
